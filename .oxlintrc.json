{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "node": true,
    "es2023": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "off"
  },
  "ignorePatterns": ["dist/", "raycast-env.d.ts"]
}
